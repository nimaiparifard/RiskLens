# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# --- Django
DJANGO_SECRET_KEY=CHANGE-ME-long-random-string        # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DEMO_PASSWORD=risklens-demo                           # password of the seeded demo users (admin/officer/viewer)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# --- Postgres (shared by Django, MLflow and Optuna)
POSTGRES_USER=risklens
POSTGRES_PASSWORD=CHANGE-ME
# local (non-docker) Django / CLI:
DATABASE_URL=postgres://risklens:CHANGE-ME@localhost:5432/risklens
OPTUNA_STORAGE=postgresql://risklens:CHANGE-ME@localhost:5432/optuna

# --- Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- MinIO (S3): DVC remote, MLflow artifacts, drift reports
MINIO_ROOT_USER=risklens
MINIO_ROOT_PASSWORD=CHANGE-ME-min-8-chars
AWS_ACCESS_KEY_ID=risklens
AWS_SECRET_ACCESS_KEY=CHANGE-ME-min-8-chars
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# --- MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Serving
SERVING_URL=http://localhost:8001
SERVING_INTERNAL_TOKEN=CHANGE-ME                     # shared secret backend -> serving (reload endpoint)
SHADOW_ENABLED=false                                  # score with the challenger too and log both

# --- Monitoring / retraining
DRIFT_PSI_THRESHOLD=0.2
DRIFT_WINDOW_HOURS=24
DRIFT_MIN_SAMPLES=500                                 # skip the report below this (PSI is noisy on small samples)
AUTO_RETRAIN_ON_DRIFT=false
GITHUB_REPOSITORY=                                    # owner/repo - for workflow_dispatch of ml-train.yml
GITHUB_TOKEN=                                         # fine-grained token with actions:write

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME
